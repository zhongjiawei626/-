page{background:#f6f7f4;color:#17241f;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;font-size:28rpx}view,text,button,input{box-sizing:border-box}button{font-weight:500;font-size:26rpx;line-height:1.5;margin:0;border-radius:16rpx}button::after{border:0}.shell{padding:32rpx 28rpx 70rpx}.hero{display:flex;flex-direction:column;gap:16rpx;margin-bottom:28rpx}.title{font-size:46rpx;font-weight:700}.eyebrow{font-size:20rpx;letter-spacing:3rpx;color:#246c53}.muted{color:#87918a}.small{font-size:22rpx}.block{display:block;margin-top:6rpx}.primary{background:#246c53;color:white;padding:20rpx 26rpx}.secondary{background:#eaf3ed;color:#246c53;padding:14rpx 22rpx}.card{background:#fff;border:1rpx solid #edf0eb;border-radius:28rpx;padding:28rpx;margin-bottom:24rpx}.row{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.heading{font-size:28rpx;font-weight:650}.metric-picker{max-width:390rpx;background:#fff;border:1rpx solid #e8ebe6;padding:12rpx 18rpx;color:#246c53;white-space:normal}.stat{font-size:58rpx;font-weight:700;margin:32rpx 0 16rpx}.unit{font-size:22rpx;color:#87918a;font-weight:400}.hint{display:block;color:#87918a;font-size:20rpx;line-height:1.6;margin-top:16rpx}.chart-host,.chart{width:100%;height:240px}.record{padding:24rpx 0;border-bottom:1rpx solid #edf0eb;display:flex;justify-content:space-between;gap:16rpx}.record-name{font-weight:550;font-size:26rpx}.record-value{text-align:right;font-size:28rpx;flex-shrink:0}.pending{color:#ad6b34;background:#fff0e5;padding:3rpx 10rpx;border-radius:10rpx}.empty{padding:40rpx 10rpx;text-align:center;color:#87918a;font-size:24rpx;line-height:1.7}.text-button{padding:6rpx;color:#246c53;background:transparent}.notice{background:#eaf3ed;color:#426b55;font-size:23rpx;padding:20rpx;border-radius:18rpx;margin-bottom:24rpx;line-height:1.6}.report{display:flex;gap:20rpx;align-items:center;border-bottom:1rpx solid #edf0eb;padding:20rpx 0}.report image,.pdf-icon{width:80rpx;height:100rpx;flex-shrink:0;border-radius:10rpx}.pdf-icon{background:#f4ebe8;color:#a64b3c;display:flex;align-items:center;justify-content:center}.report-name{font-size:24rpx;overflow-wrap:anywhere}.footnote{font-size:20rpx;color:#969e97;line-height:1.8}.ocr-context{position:fixed;left:-20px;top:-20px;width:1px;height:1px;opacity:0}.shade{position:fixed;inset:0;background:rgba(24,35,30,.38);z-index:20;display:flex;align-items:flex-end}.sheet{width:100%;background:#fff;border-radius:30rpx 30rpx 0 0;padding:28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom))}.metric-list{height:60vh;margin-top:18rpx}.metric-line{display:flex;align-items:center;gap:5rpx;border-bottom:1rpx solid #edf0eb;padding:18rpx 0}.metric-name{flex:1;font-size:26rpx;overflow-wrap:anywhere}.tiny{background:transparent;color:#87918a;font-size:22rpx;padding:10rpx 8rpx;flex-shrink:0}.active{color:#246c53;font-weight:650}.metric-edit{padding:20rpx;background:#f6f7f4;border-radius:16rpx}.metric-edit input{border:1rpx solid #e8ebe6;background:#fff;padding:16rpx;margin-bottom:16rpx}.deleted{font-size:23rpx;color:#87918a;padding:14rpx}.danger{color:#b86445}.editor-shade{z-index:30}.editor-sheet{height:96vh;display:flex;flex-direction:column;gap:16rpx}.preview{height:27vh;flex-shrink:0;background:#f4f5f2;display:flex;align-items:center;justify-content:center;border-radius:14rpx;font-size:24rpx;text-align:center}.preview image{width:100%;height:100%}.pdf-preview{display:flex;flex-direction:column;gap:12rpx;color:#246c53;padding:20rpx}.edit-fields{flex:1;min-height:0}.field{margin-bottom:20rpx}.field>text{display:block;font-size:22rpx;color:#87918a;margin-bottom:8rpx}.field input,.input{border:1rpx solid #e8ebe6;border-radius:12rpx;padding:16rpx;min-height:76rpx;font-size:26rpx;background:#fff}.two-col{display:flex;gap:20rpx}.two-col .field{flex:1;min-width:0}
