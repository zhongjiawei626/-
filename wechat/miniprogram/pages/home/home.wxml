<view class="shell">
  <view class="hero"><text class="eyebrow">PERSONAL HEALTH</text><text class="title">检查报告，一目了然</text><text class="muted">保留原件，追踪每一次检查</text><button class="primary" loading="{{busy}}" disabled="{{busy}}" bindtap="importMenu">＋ 导入图片 / PDF / 记录</button></view>
  <view class="card"><view class="row"><text class="heading">指标走势</text><button class="metric-picker" bindtap="toggleMetrics">{{selectedName}} ▾</button></view><view class="stat">{{latest}} <text class="unit">{{unit}}</text></view><view class="row muted small"><text>绿线已确认 · 橙色虚线待核对</text><text bindtap="recent">最新半年 ↻</text></view><text class="hint">背景：蓝色偏低 / 绿色范围内 / 橙色偏高；缺少参考范围时留白</text><view id="chartHost" class="chart-host"><canvas hidden="{{metricOpen || editOpen}}" canvas-id="trendCanvas" class="chart" disable-scroll="true" bindtouchstart="touchStart" catchtouchmove="touchMove" bindtouchend="touchEnd"></canvas></view><view class="row small muted"><text>{{range}}</text><text>{{count}} 次 · 待核对 {{pendingCount}}</text></view><text class="hint">左右滑动查看更早数据，点击数值点对照原报告编辑</text></view>
  <view wx:if="{{status}}" class="notice">{{status}}</view>
  <view class="card"><view class="row"><text class="heading">检查记录 · {{records.length}}</text><button class="text-button" bindtap="exportRecords">导出</button></view><view wx:if="{{!records.length}}" class="empty">还没有检查记录，可从网页导出 JSON 后通过微信聊天导入。</view><view wx:for="{{records}}" wx:key="id" class="record" data-id="{{item.id}}" bindtap="editRecord"><view><text class="record-name">{{item.label}}</text><text class="muted small block">{{item.date}} <text wx:if="{{item.needsReview}}" class="pending">待核对</text></text></view><view class="record-value">{{item.value}} <text class="unit">{{item.unit}}</text><text class="muted small block">编辑 ›</text></view></view></view>
  <view class="card"><text class="heading">报告库 · {{reports.length}}</text><view wx:if="{{!reports.length}}" class="empty">导入的图片和 PDF 原件会保存在当前手机。</view><view wx:for="{{reports}}" wx:key="id" class="report" data-id="{{item.id}}" bindtap="reportActions"><image wx:if="{{item.type === 'image'}}" src="{{item.path}}" mode="aspectFill"/><view wx:else class="pdf-icon">PDF</view><view class="report-name"><text>{{item.title}}</text><text class="muted small block">{{item.date}} · {{item.ocrLabel}}</text></view></view></view>
  <text class="footnote">本地档案保存在当前手机，网页浏览器中的数据不会自动同步。图片识别采用微信端侧能力，设备不支持时会保留原件并提示；PDF 当前支持原件查看和手动记录。</text>
  <canvas id="ocrContext" type="webgl" class="ocr-context"></canvas>
</view>
<view wx:if="{{metricOpen}}" class="shade" bindtap="toggleMetrics"><view class="sheet metric-sheet" catchtap="noop"><view class="row"><text class="heading">选择指标</text><text bindtap="toggleMetrics">关闭</text></view><text class="hint">在列表内置顶、上下排序，点 ••• 重命名或删除</text><scroll-view scroll-y class="metric-list"><view wx:for="{{metrics}}" wx:key="key" class="metric-line"><text class="metric-name" data-key="{{item.key}}" bindtap="pickMetric">{{item.name}}</text><button class="tiny {{item.pinned ? 'active' : ''}}" data-key="{{item.key}}" data-action="pin" bindtap="metricAction">{{item.pinned ? '已置顶' : '置顶'}}</button><button class="tiny" data-key="{{item.key}}" data-action="up" bindtap="metricAction">↑</button><button class="tiny" data-key="{{item.key}}" data-action="down" bindtap="metricAction">↓</button><button class="tiny" data-key="{{item.key}}" data-action="more" bindtap="metricAction">•••</button></view><view wx:if="{{metricEdit}}" class="metric-edit"><input value="{{metricEdit.name}}" bindinput="metricName" placeholder="指标名称"/><view class="row"><button class="secondary" bindtap="saveMetricName">保存名称</button><button class="text-button danger" data-key="{{metricEdit.key}}" data-action="delete" bindtap="metricAction">删除指标</button></view></view><view wx:for="{{deletedMetrics}}" wx:key="key" class="row deleted"><text>已删除：{{item.name}}</text><button class="tiny" data-key="{{item.key}}" data-action="restore" bindtap="metricAction">恢复</button></view></scroll-view></view></view>
<view wx:if="{{editOpen}}" class="shade editor-shade"><view class="sheet editor-sheet"><view class="row"><text class="heading">对照原报告编辑</text><text bindtap="closeEditor">取消</text></view><view class="preview"><image wx:if="{{editingReport.type === 'image'}}" src="{{editingReport.path}}" mode="aspectFit" bindtap="viewEditingReport"/><view wx:elif="{{editingReport.type === 'pdf'}}" class="pdf-preview" bindtap="viewEditingReport"><text>PDF 原始报告</text><text class="small">点击打开，返回后保留修改草稿</text></view><text wx:else class="muted">未关联原件，可在下方选择已导入的报告。</text></view><scroll-view scroll-y class="edit-fields"><view class="field"><text>检查日期</text><picker mode="date" value="{{form.date}}" bindchange="dateField"><view class="input">{{form.date}}</view></picker></view><view class="field"><text>检查项目</text><input value="{{form.metric}}" data-field="metric" bindinput="field"/></view><view class="two-col"><view class="field"><text>结果</text><input value="{{form.value}}" data-field="value" bindinput="field"/></view><view class="field"><text>单位</text><input value="{{form.unit}}" data-field="unit" bindinput="field"/></view></view><view class="field"><text>参考范围（按输入单位）</text><input value="{{form.referenceRange}}" data-field="referenceRange" bindinput="field" placeholder="如：3.5–5.5、≤30"/></view><view class="field"><text>关联原报告</text><picker range="{{reportOptions}}" range-key="name" value="{{reportIndex}}" bindchange="reportField"><view class="input">{{reportOptions[reportIndex].name}}</view></picker></view><view class="field"><text>移动到其他指标</text><picker range="{{moveOptions}}" range-key="name" value="{{moveIndex}}" bindchange="moveField"><view class="input">{{moveOptions[moveIndex].name}}</view></picker></view><view class="field"><text>备注</text><input value="{{form.note}}" data-field="note" bindinput="field"/></view><text class="hint">保存后标记为已核对，移除待核对标签并更新走势图。</text></scroll-view><button class="primary" bindtap="saveRecord">保存并确认</button></view></view>
